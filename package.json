{
  "name": "o-an-quan-cyber-folk",
  "version": "1.0.0",
  "description": "Ô Ăn Quan — Cyber Folk Edition (Local WebSocket & AI Bot)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan.bold,emerald.bold\" \"tsx watch server/index.ts\" \"vite\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run"
  },
  "keywords": [
    "o-an-quan",
    "boardgame",
    "vietnam",
    "websocket",
    "cyberfolk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dducnv/gdg-project.git"
  },
  "homepage": "https://github.com/dducnv/gdg-project",
  "author": "GDG Community",
  "license": "MIT",
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
